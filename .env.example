# Public API endpoint used by the browser.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Shared MongoDB database (Better Auth and the Express API use the same DB).
MONGODB_URI=mongodb://127.0.0.1:27017/mentorLagbe
DB_NAME=mentorLagbe

# Better Auth session configuration.
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Must match JWT_SECRET in the server environment.
JWT_SECRET=replace-with-the-same-secret-as-the-server
JWT_EXPIRES_IN=7d
